@baseUrl = https://localhost:7006/fhir
@apiKey = dev-medical-kit-key-change-me
@patientId = 2627530575

### 1. Capabilities (public, no API key)
GET {{baseUrl}}/metadata
Accept: application/fhir+json

### 2. Missing API key -> 401 OperationOutcome
GET {{baseUrl}}/Patient?identifier=http://nphies.sa/identifier/nationalid|1123456781
Accept: application/fhir+json

### 3. Patient by national ID (set a real HIS national ID) -> Bundle with 1 entry
GET {{baseUrl}}/Patient?identifier=http://nphies.sa/identifier/nationalid|1123456781
Accept: application/fhir+json
X-Api-Key: {{apiKey}}

### 4. Patient by Iqama -> Bundle with 1 entry
GET {{baseUrl}}/Patient?identifier=http://nphies.sa/identifier/iqama|2627530575
Accept: application/fhir+json
X-Api-Key: {{apiKey}}

### 5. Unknown national ID -> empty Bundle (total 0), not 404
GET {{baseUrl}}/Patient?identifier=http://nphies.sa/identifier/nationalid|1000000000
Accept: application/fhir+json
X-Api-Key: {{apiKey}}

### 6. Patient read by id
GET {{baseUrl}}/Patient/{{patientId}}
Accept: application/fhir+json
X-Api-Key: {{apiKey}}

### 7. Vital types CodeSystem
GET {{baseUrl}}/CodeSystem/medical-kit-vital-type
Accept: application/fhir+json
X-Api-Key: {{apiKey}}

### 8. Send readings as a batch Bundle (all 9 types from docs/Vital Types.md)
POST {{baseUrl}}
Content-Type: application/fhir+json
Accept: application/fhir+json
X-Api-Key: {{apiKey}}

{
  "resourceType": "Bundle",
  "type": "batch",
  "entry": [
    {
      "resource": {
        "resourceType": "Observation",
        "identifier": [{ "system": "http://fakeeh.example/medical-kit/reading-id", "value": "KIT-DEMO-BP-0001" }],
        "status": "final",
        "category": [{ "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/observation-category", "code": "vital-signs" }] }],
        "code": {
          "coding": [
            { "system": "http://loinc.org", "code": "85354-9", "display": "Blood pressure panel" },
            { "system": "http://fakeeh.example/medical-kit/vital-type", "code": "BP" }
          ],
          "text": "Blood Pressure"
        },
        "subject": { "reference": "Patient/{{patientId}}" },
        "effectiveDateTime": "2026-10-18T07:58:42+03:00",
        "performer": [{ "reference": "Practitioner/3" }],
        "component": [
          {
            "code": { "coding": [{ "system": "http://loinc.org", "code": "8480-6" }] },
            "valueQuantity": { "value": 121, "unit": "mmHg", "system": "http://unitsofmeasure.org", "code": "mm[Hg]" }
          },
          {
            "code": { "coding": [{ "system": "http://loinc.org", "code": "8462-4" }] },
            "valueQuantity": { "value": 81, "unit": "mmHg", "system": "http://unitsofmeasure.org", "code": "mm[Hg]" }
          }
        ],
        "note": [{ "text": "قراءة ضغط الدم من جهاز الموبايل" }],
        "extension": [{ "url": "http://fakeeh.example/fhir/StructureDefinition/reading-address", "valueString": "السعوديه , الرياض" }]
      },
      "request": { "method": "POST", "url": "Observation", "ifNoneExist": "identifier=http://fakeeh.example/medical-kit/reading-id|KIT-DEMO-BP-0001" }
    },
    {
      "resource": {
        "resourceType": "Observation",
        "identifier": [{ "system": "http://fakeeh.example/medical-kit/reading-id", "value": "KIT-DEMO-HR-0001" }],
        "status": "final",
        "code": { "coding": [{ "system": "http://loinc.org", "code": "8867-4" }, { "system": "http://fakeeh.example/medical-kit/vital-type", "code": "HR" }] },
        "subject": { "reference": "Patient/{{patientId}}" },
        "effectiveDateTime": "2026-10-18T07:58:42+03:00",
        "valueQuantity": { "value": 119, "unit": "bpm", "system": "http://unitsofmeasure.org", "code": "/min" },
        "interpretation": [{ "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation", "code": "H" }] }]
      },
      "request": { "method": "POST", "url": "Observation" }
    },
    {
      "resource": {
        "resourceType": "Observation",
        "identifier": [{ "system": "http://fakeeh.example/medical-kit/reading-id", "value": "KIT-DEMO-SPO2-0001" }],
        "status": "final",
        "code": { "coding": [{ "system": "http://loinc.org", "code": "59408-5" }, { "system": "http://fakeeh.example/medical-kit/vital-type", "code": "SPO2" }] },
        "subject": { "reference": "Patient/{{patientId}}" },
        "effectiveDateTime": "2026-10-18T07:58:42+03:00",
        "valueQuantity": { "value": 70, "unit": "%", "system": "http://unitsofmeasure.org", "code": "%" },
        "interpretation": [{ "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation", "code": "L" }] }]
      },
      "request": { "method": "POST", "url": "Observation" }
    },
    {
      "resource": {
        "resourceType": "Observation",
        "identifier": [{ "system": "http://fakeeh.example/medical-kit/reading-id", "value": "KIT-DEMO-TEMP-0001" }],
        "status": "final",
        "code": { "coding": [{ "system": "http://fakeeh.example/medical-kit/vital-type", "code": "TEMP" }] },
        "subject": { "reference": "Patient/{{patientId}}" },
        "effectiveDateTime": "2026-10-18T07:58:42+03:00",
        "valueQuantity": { "value": 37.5, "unit": "°C", "system": "http://unitsofmeasure.org", "code": "Cel" }
      },
      "request": { "method": "POST", "url": "Observation" }
    },
    {
      "resource": {
        "resourceType": "Observation",
        "identifier": [{ "system": "http://fakeeh.example/medical-kit/reading-id", "value": "KIT-DEMO-WEIGHT-0001" }],
        "status": "final",
        "code": { "coding": [{ "system": "http://fakeeh.example/medical-kit/vital-type", "code": "WEIGHT" }] },
        "subject": { "reference": "Patient/{{patientId}}" },
        "effectiveDateTime": "2026-10-18T07:58:42+03:00",
        "valueQuantity": { "value": 90, "unit": "kg", "system": "http://unitsofmeasure.org", "code": "kg" }
      },
      "request": { "method": "POST", "url": "Observation" }
    },
    {
      "resource": {
        "resourceType": "Observation",
        "identifier": [{ "system": "http://fakeeh.example/medical-kit/reading-id", "value": "KIT-DEMO-GLUCOSE-0001" }],
        "status": "final",
        "code": { "coding": [{ "system": "http://fakeeh.example/medical-kit/vital-type", "code": "GLUCOSE" }] },
        "subject": { "reference": "Patient/{{patientId}}" },
        "effectiveDateTime": "2026-10-18T07:58:42+03:00",
        "valueQuantity": { "value": 9, "unit": "mg/dL", "system": "http://unitsofmeasure.org", "code": "mg/dL" }
      },
      "request": { "method": "POST", "url": "Observation" }
    },
    {
      "resource": {
        "resourceType": "Observation",
        "identifier": [{ "system": "http://fakeeh.example/medical-kit/reading-id", "value": "KIT-DEMO-GLUCOSE-0001" }],
        "status": "final",
        "code": { "coding": [{ "system": "http://fakeeh.example/medical-kit/vital-type", "code": "GLUCOSE" }] },
        "subject": { "reference": "Patient/{{patientId}}" },
        "effectiveDateTime": "2026-10-18T07:58:42+03:00",
        "valueQuantity": { "value": 9, "unit": "mg/dL", "system": "http://unitsofmeasure.org", "code": "mg/dL" }
      },
      "request": { "method": "POST", "url": "Observation" }
    },
    {
      "resource": {
        "resourceType": "Observation",
        "identifier": [{ "system": "http://fakeeh.example/medical-kit/reading-id", "value": "KIT-DEMO-PF-0001" }],
        "status": "final",
