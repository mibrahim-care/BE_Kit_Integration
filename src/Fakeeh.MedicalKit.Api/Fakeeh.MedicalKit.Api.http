        "subject": { "reference": "Patient/{{patientId}}" },
        "effectiveDateTime": "2026-10-18T07:58:42+03:00",
        "component": [
          {
            "code": { "coding": [{ "system": "http://fakeeh.example/medical-kit/vital-field", "code": "per_min" }] },
            "valueQuantity": { "value": 13, "unit": "L/min", "system": "http://unitsofmeasure.org", "code": "L/min" }
          },
          {
            "code": { "coding": [{ "system": "http://fakeeh.example/medical-kit/vital-field", "code": "fev1_l" }] },
            "valueQuantity": { "value": 6, "unit": "L", "system": "http://unitsofmeasure.org", "code": "L" }
          }
        ]
      },
      "request": { "method": "POST", "url": "Observation" }
    },
    {
      "resource": {
        "resourceType": "Observation",
        "identifier": [{ "system": "http://fakeeh.example/medical-kit/reading-id", "value": "KIT-DEMO-BT-HB-0001" }],
        "status": "final",
        "category": [{ "coding": [{ "system": "http://terminology.hl7.org/CodeSystem/observation-category", "code": "laboratory" }] }],
        "code": {
          "coding": [
            { "system": "http://loinc.org", "code": "718-7" },
            { "system": "http://fakeeh.example/medical-kit/vital-type", "code": "BT" },
            { "system": "http://fakeeh.example/medical-kit/vital-field", "code": "hb_gdL" }
          ]
        },
        "subject": { "reference": "Patient/{{patientId}}" },
        "effectiveDateTime": "2026-10-18T07:58:42+03:00",
        "valueQuantity": { "value": 13, "unit": "g/dL", "system": "http://unitsofmeasure.org", "code": "g/dL" },
        "note": [{ "text": "قراءة فحص دم من جهاز الموبايل" }]
      },
      "request": { "method": "POST", "url": "Observation" }
    },
    {
      "resource": {
        "resourceType": "Observation",
        "identifier": [{ "system": "http://fakeeh.example/medical-kit/reading-id", "value": "KIT-DEMO-BT-NA-0001" }],
        "status": "final",
