@baseUrl = https://localhost:7006/api/MedicalKit
@apiKey = K4Qn9cWKUN3CkoMl5shGrajVGB6s5TLyg95O6aD2TCGAi80Y
@nationalId = 2627530575

### 1. Missing API key -> 401
POST {{baseUrl}}/GetPatientInfo
Content-Type: application/json

{ "nationalId": "{{nationalId}}" }

### 2. Get patient info
POST {{baseUrl}}/GetPatientInfo
Content-Type: application/json
X-Api-Key: {{apiKey}}

{ "nationalId": "{{nationalId}}" }

### 3. Unknown patient -> 404
POST {{baseUrl}}/GetPatientInfo
Content-Type: application/json
X-Api-Key: {{apiKey}}

{ "nationalId": "1000000000" }

### 4. Add vitals (one reading of every type, KIT format)
POST {{baseUrl}}/AddVitals
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "payloads": [
    { "readingId": "KIT-DEMO-BT-0001", "vitalTypeCode": "BT", "nationalId": "{{nationalId}}", "dateTime": "2026-10-18T07:58:42",
      "readingValues": { "hb_gdL": 13, "glucometer_mgdL": 50, "lactate_mmoll": 11, "ketone_mmoll": 22, "na_mmoll": 13, "k_mmoll": 20 },
      "notes": "قراءة فحص دم من جهاز الموبايل", "address": "السعوديه , الرياض" },
    { "readingId": "KIT-DEMO-BC-0001", "vitalTypeCode": "BC", "nationalId": "{{nationalId}}", "dateTime": "2026-10-18T07:58:42",
      "readingValues": { "bmi": 27.4, "body_fat": 10, "body_fat_percentage": 5, "body_water_percentage": 60, "visceral_fat": 20, "skeletal_muscle": 30, "resting_metabolism": 4, "basal_metabolic_rate": 19, "protein_levels": 11, "mineral": 10 } },
    { "readingId": "KIT-DEMO-BP-0001", "vitalTypeCode": "BP", "nationalId": "{{nationalId}}", "dateTime": "2026-10-18T07:58:42",
      "readingValues": { "systolic": 121, "diastolic": 81 }, "isAbnormal": false, "nurseId": "3" },
    { "readingId": "KIT-DEMO-HR-0001", "vitalTypeCode": "HR", "nationalId": "{{nationalId}}", "dateTime": "2026-10-18T07:58:42",
      "readingValues": { "Value": 119 }, "isAbnormal": true },
    { "readingId": "KIT-DEMO-SPO2-0001", "vitalTypeCode": "SPO2", "nationalId": "{{nationalId}}", "dateTime": "2026-10-18T07:58:42",
      "readingValues": { "Value": 70 }, "isAbnormal": true },
    { "readingId": "KIT-DEMO-TEMP-0001", "vitalTypeCode": "TEMP", "nationalId": "{{nationalId}}", "dateTime": "2026-10-18T07:58:42",
      "readingValues": { "Value": 37.5 } },
    { "readingId": "KIT-DEMO-GLUCOSE-0001", "vitalTypeCode": "GLUCOSE", "nationalId": "{{nationalId}}", "dateTime": "2026-10-18T07:58:42",
      "readingValues": { "Value": 9 } },
    { "readingId": "KIT-DEMO-PF-0001", "vitalTypeCode": "PF", "nationalId": "{{nationalId}}", "dateTime": "2026-10-18T07:58:42",
      "readingValues": { "per_min": 13, "fev1_l": 6 } },
    { "readingId": "KIT-DEMO-WEIGHT-0001", "vitalTypeCode": "WEIGHT", "nationalId": "{{nationalId}}", "dateTime": "2026-10-18T07:58:42+03:00",
      "readingValues": { "Value": 90 } },
    { "readingId": "KIT-DEMO-BAD-0001", "vitalTypeCode": "BP", "nationalId": "{{nationalId}}",
      "readingValues": { "systolic": 120, "pulse": 70 } }
  ]
}

### 5. Latest 5 readings of each vital type
POST {{baseUrl}}/GetLatestVitals
Content-Type: application/json
X-Api-Key: {{apiKey}}

{ "nationalId": "{{nationalId}}", "recordsPerType": 5 }

### 6. Latest blood tests in a date range
POST {{baseUrl}}/GetLatestVitals
Content-Type: application/json
X-Api-Key: {{apiKey}}

{
  "nationalId": "{{nationalId}}",
  "recordsPerType": 5,
  "vitalTypeCode": "BT",
  "dateFrom": "2026-05-01",
  "dateTo": "2026-10-31"
}
