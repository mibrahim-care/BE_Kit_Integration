<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Fakeeh.MedicalKit.Application\Fakeeh.MedicalKit.Application.csproj" />
    <ProjectReference Include="..\Fakeeh.MedicalKit.Infrastructure\Fakeeh.MedicalKit.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.R4" Version="5.12.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Swagger content of the KIT integration document; generated by tools/generate-swagger-examples.js. -->
    <EmbeddedResource Include="Swagger\kit-swagger.json" LogicalName="Fakeeh.MedicalKit.Api.Swagger.kit-swagger.json" />
    <Content Remove="Swagger\kit-swagger.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
